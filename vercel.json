{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/t/:code",
      "destination": "/api/ticket?c=:code"
    }
  ],
  "regions": [
    "sfo1"
  ],
  "functions": {
    "api/hoco/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/hocotickets",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hocorallymusic",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
