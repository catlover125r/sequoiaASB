{
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "sfo1"
  ],
  "headers": [
    {
      "source": "/hocotickets",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
